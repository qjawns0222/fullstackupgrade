{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LoginRequest",
  "type": "object",
  "required": ["username", "password"],
  "properties": {
    "username": {
      "type": "string",
      "minLength": 7,
      "maxLength": 20,
      "description": "Username (7-20 characters)"
    },
    "password": {
      "type": "string",
      "minLength": 6,
      "description": "Password (min 6 characters)"
    }
  },
  "additionalProperties": false
}
